{
  "name": "rxnflow-web",
  "private": true,
  "version": "0.1.3",
  "description": "Local-first reaction canvas workbench for RxnFlow.",
  "author": "RxnFlow",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "preview": "vite preview --host 127.0.0.1",
    "build": "tsc -b && vite build && node scripts/check-bundle-budgets.cjs",
    "desktop": "npm run desktop:icons && npm run build && electron electron/main.cjs",
    "desktop:dev": "node scripts/desktop-dev.cjs",
    "desktop:engine": "node scripts/build-engine.cjs",
    "desktop:icons": "node scripts/generate-icons.cjs",
    "desktop:smoke": "node electron/smoke.cjs",
    "desktop:release:smoke": "npm run desktop:icons && node electron/release-smoke.cjs",
    "desktop:runtime:smoke": "node electron/runtime-smoke.cjs",
    "desktop:installer:smoke:win": "node electron/windows-installer-smoke.cjs",
    "desktop:pack": "npm run desktop:icons && npm run desktop:engine && npm run build && electron-builder --mac dir --publish never --config.mac.identity=null",
    "desktop:pack:win": "npm run desktop:icons && npm run desktop:engine && npm run build && electron-builder --win --x64 --dir --publish never",
    "desktop:dist:mac": "npm run desktop:icons && npm run desktop:engine && npm run build && electron-builder --mac --publish never",
    "desktop:dist:mac:unsigned": "npm run desktop:icons && npm run desktop:engine && npm run build && RXNFLOW_MAC_ADHOC_SIGN=1 electron-builder --mac --publish never --config.mac.identity=null",
    "desktop:notarize:mac": "node scripts/notarize-mac.cjs",
    "desktop:dist:win": "npm run desktop:icons && npm run desktop:engine && npm run build && electron-builder --win --x64 --publish never",
    "desktop:release:manifest": "node scripts/generate-release-manifest.cjs",
    "perf:parser": "python3 ../tests/benchmarks/gaussian_parser_benchmark.py && python3 ../tests/benchmarks/orca_parser_benchmark.py",
    "perf:bundle": "npm run build",
    "perf:e2e": "node scripts/perf-e2e.cjs",
    "test": "vitest run && node --test scripts/check-bundle-budgets.test.cjs scripts/browser-engine.test.cjs scripts/perf-e2e.test.cjs scripts/generate-release-notes.test.cjs"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.8.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "3dmol": "^2.5.5",
    "electron": "^42.11.10",
    "electron-builder": "^26.15.3",
    "jsdom": "^29.1.1",
    "ketcher-core": "^3.15.0",
    "ketcher-react": "^3.15.0",
    "ketcher-standalone": "^3.15.0",
    "lucide-react": "^1.24.0",
    "playwright": "^1.60.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^6.0.3",
    "vite": "^8.0.13",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "global-agent@^3.0.0": {
      "roarr": "6.0.0"
    }
  },
  "build": {
    "appId": "com.rxnflow.app",
    "productName": "RxnFlow",
    "asar": true,
    "afterPack": "scripts/after-pack.cjs",
    "electronLanguages": [
      "en",
      "en-US",
      "zh-CN",
      "zh-TW",
      "zh_CN",
      "zh_TW"
    ],
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "icon": "build/icon.png",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png",
      "build/icon.ico",
      "legal/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "engine",
        "to": "engine",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSAllowsLocalNetworking": false
        }
      },
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    }
  },
  "dependencies": {
    "archiver": "7.0.1",
    "yauzl": "3.4.0"
  }
}
